{
	"name": "missionaire-web",
	"version": "2.0.0",
	"private": true,
	"packageManager": "pnpm@10.17.1",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"start": "node scripts/start-server.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "npm run lint:mongodb && prettier --check . && ESLINT_USE_FLAT_CONFIG=false eslint .",
		"format": "prettier --write .",
		"prepare": "husky",
		"stream:up": "docker compose -f ops/streaming/docker-compose.yml up -d --build",
		"stream:down": "docker compose -f ops/streaming/docker-compose.yml down",
		"stream:logs": "docker compose -f ops/streaming/docker-compose.yml logs -f --tail=100",
		"lyrics:match": "node scripts/create-lyrics-match-list.mjs",
		"literature:migrate-zips": "node --env-file=admin/.env.local scripts/migrate-literature-zips.mjs",
		"library:repair-urls": "node --env-file=admin/.env.local scripts/repair-library-asset-urls.mjs",
		"sermons:sync": "node --env-file-if-exists=.env.local scripts/sync-branham-sermons.mjs",
		"sermons:migrate-assets": "node --env-file-if-exists=admin/.env.local scripts/migrate-sermon-assets.mjs",
		"sermons:backfill-durations": "node --env-file-if-exists=admin/.env.local scripts/backfill-sermon-durations.mjs",
		"channel:import": "node scripts/import-whatsapp-channel.mjs",
		"channel:test": "node scripts/import-whatsapp-channel.mjs --test",
		"lint:mongodb": "npm exec --yes --ignore-scripts --package=eslint-plugin-mongodb-security@9.1.3 -- eslint --config eslint.security.config.mjs src admin/src",
		"security:gate": "node scripts/security-gate.mjs",
		"security:verify": "node scripts/verify-web-security.mjs && DEPLOY_TARGET=node pnpm build && DEPLOY_TARGET=node pnpm --dir admin build && node scripts/smoke-web-security.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^25.0.3",
		"@types/web-push": "^3.6.4",
		"@typescript-eslint/eslint-plugin": "^8.57.2",
		"@typescript-eslint/parser": "^8.57.2",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^8.10.0",
		"eslint-plugin-svelte": "^2.46",
		"husky": "^9.1.7",
		"iconsax-svelte": "0.0.1-alpha.11",
		"lint-staged": "^17.3.0",
		"postcss": "^8.5.28",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^3.3.3",
		"tslib": "^2.6.2",
		"typescript": "^6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.0.0"
	},
	"type": "module",
	"lint-staged": {
		"*": "prettier --write --ignore-unknown"
	},
	"pnpm": {
		"overrides": {
			"cookie": "^2.0.1",
			"undici": "7.30.2",
			"postcss-selector-parser": "7.1.6",
			"source-map-js": "1.2.2"
		},
		"patchedDependencies": {
			"picomatch@2.3.2": "patches/picomatch@2.3.2.patch",
			"picomatch@4.0.7": "patches/picomatch@4.0.7.patch"
		},
		"auditConfig": {
			"ignoreGhsas": [
				"GHSA-fc5q-39xc-vjpf"
			]
		}
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1116.0",
		"@aws-sdk/s3-request-presigner": "^3.1116.0",
		"client-zip": "^2.5.0",
		"geoip-country": "5.0.202611250539",
		"hls.js": "^1.6.16",
		"mongodb": "^6.8.0",
		"pdfjs-dist": "^6.3.289",
		"sharp": "^0.35.5",
		"svelte-icons-pack": "^2.1.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.6"
	}
}
