# Server-only settings for the local Docker streaming stack.
# Copy to ops/streaming/.env; never distribute this file with Missionnaire Studio.
RECORDER_TOKEN="change-me"
RTMP_PUBLIC_URL="rtmp://localhost:1935/live"
MONGODB_URI=""
MONGODB_DB="youtube_data"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_S3_REGION=""
ICECAST_URL="http://icecast:8000/radio.mp3"
MAX_RECORDING_SECONDS="14400"
