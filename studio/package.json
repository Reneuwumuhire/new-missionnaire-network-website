		"@tauri-apps/plugin-updater": "^2.10.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tauri-apps/cli": "^2.9.1",
		"@types/node": "^24.13.4",
		"autoprefixer": "^10.4.20",
		"devalue": "5.9.3",
		"postcss": "^8.5.28",
		"svelte": "^5.55.7",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^3.3.3",
